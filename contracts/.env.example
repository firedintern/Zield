# Copy this file to .env and fill in real values (never commit secrets)

# RPCs
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

# For forking in tests (highly recommended)
BASE_MAINNET_RPC=https://mainnet.base.org

# Deployer / Keeper keys (use hardware or multisig in production)
DEPLOYER_PRIVATE_KEY=0x...

# Block explorer
BASESCAN_API_KEY=...

# Optional: Tenderly or other simulation providers for keeper
TENDERLY_ACCESS_KEY=...
