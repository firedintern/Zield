# Zield Keeper Environment
# Copy to .env and fill values

# === RPCs ===
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

# === Real Vault Mode (the good stuff) ===
# After you deploy the vault (see contracts README), set this.
# The keeper will then read live TVL, strategy balances, and APYs directly from the chain.
VAULT_ADDRESS=0x...

# === Execution (advanced) ===
# KEEPER_PRIVATE_KEY=0x...   # Only for actual rebalance execution on testnet/mainnet. Use with extreme caution.

# === Frontend (if you expose keeper as API later) ===
# PORT=3001
